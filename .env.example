DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cost_sheet

# Optional AI insights
ANTHROPIC_API_KEY=

# CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173

# S3 part-image storage (leave AWS_S3_BUCKET empty to use local ./backend/static/uploads)
AWS_S3_BUCKET=
AWS_REGION=ap-south-1
AWS_S3_PREFIX=costsheet/uploads
# Credentials: ~/.aws/credentials or AWS_SHARED_CREDENTIALS_FILE (never commit keys)
